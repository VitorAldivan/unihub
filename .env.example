# ==============================================================================
# UniHub — Exemplo de Variáveis de Ambiente (.env.example)
# NUNCA insira senhas reais ou chaves de produção neste arquivo.
# Copie este arquivo para .env localmente: cp .env.example .env
# ==============================================================================

# Aplicação
APP_ENV=local
DEBUG=True
SECRET_KEY=change_me_super_secret_local_key_min_32_chars
ALLOWED_ORIGINS=http://localhost:3000

# Banco de Dados (PostgreSQL)
DATABASE_URL=postgresql+psycopg://unihub_app:unihub_password@localhost:5432/unihub_db
POSTGRES_USER=unihub_app
POSTGRES_PASSWORD=unihub_password
POSTGRES_DB=unihub_db
POSTGRES_PORT=5432

# Cache e Filas (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Autenticação JWT (Fase 2)
JWT_SECRET=change_me_super_secret_jwt_key
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# Armazenamento de Arquivos S3 / MinIO (Fase 6)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=unihub-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# IA / LLM (Fase 7)
GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui

# E-mail em Desenvolvimento (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
